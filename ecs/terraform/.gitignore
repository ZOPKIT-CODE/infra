# Terraform state can contain SECRETS (e.g. the Valkey auth token) — never commit.
*.tfstate
*.tfstate.*
*.tfstate.backup

# Provider plugins / lock dir and saved plans.
.terraform/
*.tfplan
tf.plan
crash.log

# Local var files may carry environment specifics; keep the committed tfvars only.
# The deployed image tag is NOT tracked in git — it lives in SSM Parameter Store
# at /<project>/<env>/deployed-tag/<service> and is read at plan time (services.tf).
*.auto.tfvars.json
